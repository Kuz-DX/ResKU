# Python cache
__pycache__/
*.pyc
*.egg-info/

# Python virtual environment
.venv/

# ROS2 / colcon
build/
install/
log/

# 루트에 보관한 이전 ROS2 / colcon 산출물
/build.stale-*/
/install.stale-*/
/log.stale-*/

# VSCode
.vscode/

# ROS2 bag 녹화 결과물 — 용량 크고 재현 가능한 산출물이라 git으로 추적하지 않는다.
# rosbag2_* : ros2 bag record 기본 네이밍(-o 없이 실행 시)
# *_bag/, *_bag_all/ : howtorun.md 예시에서 -o로 지정하는 네이밍
rosbag2_*/
*_bag/
*_bag_all/

# ultralytics 학습 산출물 — 검증된 가중치만 의도적으로 config/models/로
# 수동 복사한다 (config/models/README.md 참고). 재현 가능한 산출물이라
# git으로 추적하지 않는다.
runs/

# [2026-08-30, 사용자 요청] 학습된 가중치(.pt) 전체를 git 추적에서 제외 —
# 기존엔 크기가 작은(<50MB) 가중치는 커밋하고, 큰 것(supplybox_v2.pt,
# 116MB — GitHub 파일당 100MB 하드 리밋 초과로 push 자체가 거부됨, 실측
# 확인됨)이나 개별 요청이 있는 것만 파일명으로 하나씩 여기 추가했는데,
# 이제 패턴 하나로 통일한다. .pt는 GPU/일반 PyTorch용 원본 체크포인트이고,
# 실제 배포에 쓰이는 CPU 추론용 OpenVINO IR 변환본(*_openvino_model/의
# .bin/.xml/metadata.yaml)은 이 패턴에 안 걸려 계속 git으로 추적된다
# (용량도 훨씬 작음 — config/models/README.md 참고). ultralytics 사전학습
# 베이스 가중치(yolo26n-seg.pt, YOLO() 최초 실행 시 자동 다운로드,
# 사전학습 베이스 가중치도 이 패턴에 자동으로 걸린다.
#
# git으로 안 딸려가므로, .pt를 model_path로 직접 참조하는 노드를 실행할
# 머신(jecs 등)에는 수동으로 복사해둬야 한다 — summer_supply.py
# (supplybest.pt/supplybox_v2.pt), summer_traffic.py(trafficlightv1.pt).
*.pt

# API 키/시크릿은 환경변수로만 전달한다. 나중에 로컬 파일로 관리하게 될
# 경우를 대비한 방어적 규칙.
.env
*.key
secrets/
