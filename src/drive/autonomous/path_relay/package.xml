<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>path_relay</name>
  <version>0.0.1</version>
  <description>
    Relays a perception-provided track-centerline nav_msgs/Path (in a
    robot-relative frame, e.g. camera_link) into controller_server's
    FollowPath action, bypassing planner_server/bt_navigator entirely.
  </description>
  <maintainer email="rim@example.com">rim</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
