<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypesversion="2.0"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.0.0</version>
  <description>Robot bringup launch and config files</description>
  <maintainer email="harim9340@gmail.com">rim</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rmd_x8_driver</exec_depend>
  <exec_depend>myahrs_driver</exec_depend>
  <exec_depend>reduced_odom</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <!-- [하림 수정] 2026-08-22: nav2_planner/nav2_bt_navigator 제거함.
       실제 주행에서 안 쓰고(nav2.launch.py 참고), controller_server
       하나만 nav2_lifecycle_manager로 관리하면 되므로 그건 유지함. -->
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>our_mppi_critics</exec_depend>
  <!-- [2026-09-04] manual_drive_sensors.launch.py가 drive_cam.launch.py를
       include(메뉴얼 주행 중 rosbag 기록용 카메라, record_manual_drive.sh 참고) -->
  <exec_depend>dolbotz</exec_depend>

  <depend>rclcpp</depend>
  <!-- [2026-09-02] autonomous.planz.py(복원된 python pure pursuit 노드)용 -->
  <exec_depend>rclpy</exec_depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <!-- [2026-08-28] slope_traverse_node의 SLOPE_EXIT pure pursuit이 /path를
       camera_link -> base_link로 변환하는 데 필요 (path_relay_node와 동일 패턴).
       기존엔 exec_depend만 있었는데 이제 빌드 시점에도 필요해서 depend로 승격. -->
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>nav_msgs</depend>
  <!-- [하림 수정] 2026-08-27: summer_supply_drive_node의 traffic 신호 구독용
       (/mission/summer_traffic/result, summer_traffic_node.py가 이미 발행) -->
  <depend>mission_manager_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
