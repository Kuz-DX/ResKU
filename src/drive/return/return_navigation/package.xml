<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>return_navigation</name>
  <version>0.0.0</version>
  <description>
    Manual-drive path recording and closed-loop autonomous return
    (180-degree turn + fixed mission-frame path following) using only
    wheel+IMU odometry (/odometry/filtered). No GPS, no LiDAR.
  </description>
  <maintainer email="harim9340@gmail.com">rim</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
