<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="tool_manipulator">

  <!-- ========================================================= -->
  <!-- PARAMETERS -->
  <!-- ========================================================= -->

  <xacro:arg name="use_mesh" default="true"/>
  <xacro:arg name="tool_id" default="0"/>

  <!-- Vehicle IMU is world origin. Values are metres. -->
  <xacro:arg name="chassis_length" default="0.78"/>
  <xacro:arg name="chassis_width" default="0.50"/>
  <xacro:arg name="chassis_height" default="0.30"/>
  <xacro:arg name="chassis_mount_x" default="0.0"/>
  <xacro:arg name="chassis_mount_y" default="0.0"/>
  <xacro:arg name="chassis_mount_z" default="0.035"/>
  <xacro:arg name="arm_world_x" default="0.1921"/>
  <xacro:arg name="arm_world_y" default="0.0"/>
  <xacro:arg name="arm_world_z" default="0.235"/>
  <xacro:arg name="imu_height_from_ground" default="0.115"/>
  <!-- Wheel radius in rmd_x8_params.yaml; with the wheel on the ground,
       its axle centre is this height above ground. -->
  <xacro:arg name="wheel_axle_height_from_ground" default="0.1125"/>
  <xacro:property name="wheel_axle_z" value="$(arg wheel_axle_height_from_ground)"/>
  <xacro:property name="imu_z" value="$(arg imu_height_from_ground)"/>
  <xacro:property name="chassis_mount_z_m" value="$(arg chassis_mount_z)"/>
  <!-- D435 mounting-centre -> depth/base origin, in the camera body axes
       X forward, Y left, Z up.  Nominal values follow the official D435
       description: 14.9 - 0.1 - 4.2 = 10.6 mm forward, 17.5 mm left,
       and half the 25 mm enclosure height. -->
  <xacro:arg name="camera_depth_from_mount_x" default="0.0106"/>
  <xacro:arg name="camera_depth_from_mount_y" default="0.0175"/>
  <xacro:arg name="camera_depth_from_mount_z" default="0.0125"/>
  <xacro:include filename="tools/tool_1_gripper.xacro"/>
  <xacro:property name="selected_tool_id" value="$(arg tool_id)"/>
  <xacro:include filename="tools/tool_2.xacro"/>
  <xacro:include filename="tools/tool_3.xacro"/>

  <xacro:property
      name="mesh_path"
      value="package://tool_manipulator_description/meshes/visual"/>
  <xacro:property name="collision_mesh_path" value="package://tool_manipulator_description/meshes/collision"/>


  <!-- ========================================================= -->
  <!-- MATERIALS -->
  <!-- ========================================================= -->

  <!-- PETG : charcoal -->
  <material name="petg_charcoal">
    <color rgba="0.20 0.20 0.22 1.0"/>
  </material>
  <material name="petg_grey"><color rgba="0.40 0.40 0.42 1.0"/></material>
  <material name="motor_dark"><color rgba="0.12 0.12 0.14 1.0"/></material>
  <material name="tool_case_marker_blue"><color rgba="0.05 0.35 1.0 1.0"/></material>
  <material name="chassis_blue"><color rgba="0.12 0.22 0.34 0.55"/></material>
  <material name="circuit_box_orange"><color rgba="0.85 0.35 0.05 0.80"/></material>

  <!-- MOTOR -->
  <material name="motor_grey">
    <color rgba="0.58 0.58 0.60 1.0"/>
  </material>


  <!-- ========================================================= -->
  <!-- VISUAL MACRO -->
  <!-- STL 자체 좌표계를 그대로 사용 -->
  <!-- STL 단위 mm -> URDF m -->
  <!-- ========================================================= -->

  <xacro:macro name="mesh_visual" params="mesh material mesh_rpy:='0 0 0'">

    <xacro:if value="$(arg use_mesh)">
      <visual>

      <!--
        중요:
        STL export origin = 해당 hinge
        STL export axes   = 해당 local frame

        기본적으로 추가 이동은 없으며, CAD 정렬이 필요한 링크만
        mesh_rpy로 시각/충돌 형상을 보정한다. 관절 운동학 프레임은
        메쉬 정렬을 위해 변경하지 않는다.
      -->
      <origin xyz="0 0 0"
              rpy="${mesh_rpy}"/>

      <geometry>
        <mesh
          filename="${mesh_path}/${mesh}.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>

      <material name="${material}"/>

    </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${mesh_rpy}"/>
        <geometry>
          <mesh filename="${collision_mesh_path}/${mesh}.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </xacro:if>

  </xacro:macro>


  <!-- ========================================================= -->
  <!-- WORLD -->
  <!-- ========================================================= -->

  <!-- Ground is z=0. Vehicle IMU/world is measured 115 mm above it. -->
  <link name="ground"/>
  <link name="world"/>
  <joint name="ground_to_world" type="fixed">
    <parent link="ground"/><child link="world"/>
    <origin xyz="0 0 $(arg imu_height_from_ground)" rpy="0 0 0"/>
  </joint>

  <!-- world is the vehicle IMU centre. chassis_mount_* is the chassis centre
       expressed in world: (0, 0, 0.035) m gives ground z range [0, 0.30] m.
       arm_world has the separately measured arm offset. -->
  <link name="chassis">
    <visual><geometry><box size="$(arg chassis_length) $(arg chassis_width) $(arg chassis_height)"/></geometry><material name="chassis_blue"/></visual>
    <collision><geometry><box size="$(arg chassis_length) $(arg chassis_width) $(arg chassis_height)"/></geometry></collision>
  </link>
  <joint name="world_to_chassis" type="fixed">
    <parent link="world"/><child link="chassis"/>
    <origin xyz="$(arg chassis_mount_x) $(arg chassis_mount_y) $(arg chassis_mount_z)" rpy="0 0 0"/>
  </joint>

  <!-- Circuit-box footprint from the eight measured points, in millimetres
       relative to the chassis centre: CAD X points right and CAD Y points
       forward. URDF X points forward and URDF Y points left, so
       (X_URDF, Y_URDF) = (Y_CAD, -X_CAD).
       The points specify the top at wheel-axle-centre Z=372 mm. Keep the
       previous 102 mm box height until a bottom-face measurement is available.
       The three boxes fill the rear bar and side arms, leaving the central
       140 x 120 mm opening empty. -->
  <link name="circuit_box">
    <!-- CAD X +/-170, Y -274.097..-114.097 mm: rear bar. -->
    <visual><origin xyz="-0.060 0 0"/><geometry><box size="0.160 0.340 0.102"/></geometry><material name="circuit_box_orange"/></visual>
    <collision><origin xyz="-0.060 0 0"/><geometry><box size="0.160 0.340 0.102"/></geometry></collision>
    <!-- CAD X -170..-70, Y -114.097..5.903 mm: left side. -->
    <visual><origin xyz="0.080 0.120 0"/><geometry><box size="0.120 0.100 0.102"/></geometry><material name="circuit_box_orange"/></visual>
    <collision><origin xyz="0.080 0.120 0"/><geometry><box size="0.120 0.100 0.102"/></geometry></collision>
    <!-- CAD X 70..170, Y -114.097..5.903 mm: right side. -->
    <visual><origin xyz="0.080 -0.120 0"/><geometry><box size="0.120 0.100 0.102"/></geometry><material name="circuit_box_orange"/></visual>
    <collision><origin xyz="0.080 -0.120 0"/><geometry><box size="0.120 0.100 0.102"/></geometry></collision>
  </link>
  <joint name="chassis_to_circuit_box" type="fixed">
    <parent link="chassis"/><child link="circuit_box"/>
    <!-- X/Y use the chassis centre. Z uses the wheel axle: box centre is
         axle height + (372 - 102/2) mm, then converted to chassis Z. -->
    <origin xyz="-0.134097 0 ${float(wheel_axle_z) + 0.321 - float(imu_z) - float(chassis_mount_z_m)}" rpy="0 0 0"/>
  </joint>

  <!-- Robot-arm reference: base height is 350 mm above ground, therefore 235 mm above the IMU/world at ground z=115 mm. -->
  <link name="arm_world"/>
  <joint name="world_to_arm_world" type="fixed">
    <parent link="world"/><child link="arm_world"/>
    <origin xyz="$(arg arm_world_x) $(arg arm_world_y) $(arg arm_world_z)" rpy="0 0 0"/>
  </joint>

  <!-- Visible centre marker only; it does not affect collision checking. -->
  <xacro:macro name="tool_case_center_marker" params="case_link marker_link">
    <link name="${marker_link}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.012"/></geometry>
        <material name="tool_case_marker_blue"/>
      </visual>
    </link>
    <joint name="${case_link}_to_center_marker" type="fixed">
      <parent link="${case_link}"/><child link="${marker_link}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- Former case 2 frame: +76.7 mm X and +90 mm Y from case 1 in arm_world. -->
  <link name="tool_case_y_plus"/>
  <joint name="arm_world_to_tool_case_y_plus" type="fixed">
    <parent link="arm_world"/><child link="tool_case_y_plus"/>
    <!-- Retain the former case-2 orientation for its dock reference frames. -->
    <origin xyz="-0.317806 0.090 0.163911809" rpy="0 -0.785398163397 0"/>
  </joint>
  <xacro:tool_case_center_marker case_link="tool_case_y_plus" marker_link="tool_case_y_plus_center"/>
  <!-- Former dock reference planes remain at local X = +/-18.4 mm. -->
  <link name="tool_case_y_plus_x_positive_face"/>
  <joint name="tool_case_y_plus_to_x_positive_face" type="fixed">
    <parent link="tool_case_y_plus"/><child link="tool_case_y_plus_x_positive_face"/>
    <origin xyz="0.0184 0 0" rpy="0 1.570796326795 0"/>
  </joint>
  <link name="tool_case_y_plus_x_negative_face"/>
  <joint name="tool_case_y_plus_to_x_negative_face" type="fixed">
    <parent link="tool_case_y_plus"/><child link="tool_case_y_plus_x_negative_face"/>
    <origin xyz="-0.0184 0 0" rpy="0 -1.570796326795 0"/>
  </joint>

  <!-- Former case 3 location: supply-box pickup area, not a measured grasp pose.
       No permanent collision; reference axes are parallel to world. -->
  <link name="supplybox_pickup_area"/>
  <joint name="arm_world_to_supplybox_pickup_area" type="fixed">
    <parent link="arm_world"/><child link="supplybox_pickup_area"/>
    <origin xyz="-0.268 -0.10245 0.153595589" rpy="0 0 0"/>
  </joint>

  <!-- Former case 1 frame retained for its centre marker and dock references. -->
  <link name="tool_case_1"/>
  <joint name="arm_world_to_tool_case_1" type="fixed">
    <parent link="arm_world"/><child link="tool_case_1"/>
    <!-- Gripper-case centre measured from the base axis: X=-394.506, Z=212.964 mm.
         base_actuator and arm_world share the same origin and orientation. -->
    <!-- Retain the former case-1 orientation for its dock reference frames. -->
    <origin xyz="-0.394506 0 0.212964" rpy="0 -0.959931088597 0"/>
  </joint>
  <xacro:tool_case_center_marker case_link="tool_case_1" marker_link="tool_case_1_center"/>
  <!-- Former case-1 dock reference planes remain at X = +/-18.4 mm. -->
  <link name="tool_case_1_x_positive_face"/>
  <joint name="tool_case_1_to_x_positive_face" type="fixed">
    <parent link="tool_case_1"/><child link="tool_case_1_x_positive_face"/>
    <origin xyz="0.0184 0 0" rpy="0 1.570796326795 0"/>
  </joint>
  <link name="tool_case_1_x_negative_face"/>
  <joint name="tool_case_1_to_x_negative_face" type="fixed">
    <parent link="tool_case_1"/><child link="tool_case_1_x_negative_face"/>
    <origin xyz="-0.0184 0 0" rpy="0 -1.570796326795 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- BASE ACTUATOR -->
  <!-- ========================================================= -->

  <link name="base_actuator">

    <xacro:mesh_visual
        mesh="base_actuator"
        material="motor_grey"/>

  </link>


  <joint name="arm_world_to_base_actuator"
         type="fixed">

    <parent link="arm_world"/>
    <child link="base_actuator"/>

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- Q1 : BASE YAW -->
  <!-- local Z = world +Z -->
  <!-- ========================================================= -->

  <link name="base_link">

    <xacro:mesh_visual
        mesh="base_link"
        material="petg_charcoal"/>

  </link>


  <joint name="base_joint"
         type="revolute">

    <parent link="base_actuator"/>
    <child link="base_link"/>

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <!-- 임시 limit -->
    <limit
        lower="-3.503"
        upper="3.614"
        effort="1.0"
        velocity="1.0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- SHOULDER ACTUATOR -->
  <!-- P1 world = (0, -37.7, 103.9) mm -->
  <!-- shoulder frame -->
  <!-- Xs = +Xw -->
  <!-- Ys = -Zw -->
  <!-- Zs = +Yw -->
  <!-- ========================================================= -->

  <link name="shoulder_actuator">

    <xacro:mesh_visual
        mesh="shoulder_actuator"
        material="motor_grey"/>

  </link>


  <joint name="shoulder_actuator_mount"
         type="fixed">

    <parent link="base_link"/>
    <child link="shoulder_actuator"/>

    <origin
        xyz="0 -0.037700 0.103900"
        rpy="${pi/2} 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- Q2 : SHOULDER PITCH -->
  <!-- ========================================================= -->

  <link name="shoulder_link">

    <xacro:mesh_visual
        mesh="shoulder_link"
        material="petg_charcoal"/>

  </link>


  <joint name="shoulder_joint"
         type="revolute">

    <parent link="base_link"/>
    <child link="shoulder_link"/>

    <origin
        xyz="0 -0.037700 0.103900"
        rpy="${pi/2} 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-1.592"
        upper="1.518"
        effort="1.0"
        velocity="1.0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- ELBOW ACTUATOR -->
  <!-- world displacement -->
  <!-- shoulder -> elbow -->
  <!-- (0, +52.578, +180) mm -->
  <!-- expressed in SHOULDER frame -->
  <!-- (0, -180, +52.578) mm -->
  <!-- ========================================================= -->

  <link name="elbow_actuator">

    <xacro:mesh_visual
        mesh="elbow_actuator"
        material="motor_grey"/>

  </link>


  <joint name="elbow_actuator_mount"
         type="fixed">

    <parent link="shoulder_link"/>
    <child link="elbow_actuator"/>

    <origin
        xyz="0 0.180000 -0.052578"
        rpy="${pi} 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- Q3 : ELBOW PITCH -->
  <!-- ========================================================= -->

  <link name="elbow_link">

    <xacro:mesh_visual
        mesh="elbow_link"
        material="petg_charcoal"
        mesh_rpy="0 ${pi} 0"/>

  </link>


  <joint name="elbow_joint"
         type="revolute">

    <parent link="shoulder_link"/>
    <child link="elbow_link"/>

    <origin
        xyz="0 0.180000 -0.052578"
        rpy="${pi} 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-1.497"
        upper="1.542"
        effort="1.0"
        velocity="1.0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- WRIST PITCH ACTUATOR -->
  <!-- world displacement -->
  <!-- elbow -> wrist pitch -->
  <!-- (0, -48.397, +200) mm -->
  <!-- expressed in ELBOW frame -->
  <!-- (0, +200, +48.397) mm -->
  <!-- ========================================================= -->

  <link name="wrist_actuator_pitch">

    <xacro:mesh_visual
        mesh="wrist_actuator_pitch"
        material="motor_grey"/>

  </link>


  <joint name="wrist_pitch_actuator_mount"
         type="fixed">

    <parent link="elbow_link"/>
    <child link="wrist_actuator_pitch"/>

    <origin
        xyz="0 -0.200000 -0.048397"
        rpy="${pi} 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- Q4 : WRIST PITCH -->
  <!-- ========================================================= -->

  <link name="wrist_link_pitch">

    <xacro:mesh_visual
        mesh="wrist_link_pitch"
        material="petg_charcoal"/>

  </link>


  <joint name="wrist_pitch_joint"
         type="revolute">

    <parent link="elbow_link"/>
    <child link="wrist_link_pitch"/>

    <origin
        xyz="0 -0.200000 -0.048397"
        rpy="${pi} 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-1.592"
        upper="1.470"
        effort="1.0"
        velocity="1.0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- WRIST ROLL ACTUATOR -->
  <!-- world displacement -->
  <!-- wrist pitch -> wrist roll -->
  <!-- (0, +33.519, +80) mm -->
  <!-- expressed in WRIST-PITCH frame -->
  <!-- (0, -80, +33.519) mm -->
  <!-- ========================================================= -->

  <link name="wrist_actuator_roll">

    <xacro:mesh_visual
        mesh="wrist_actuator_roll"
        material="motor_grey"/>

  </link>


  <joint name="wrist_roll_actuator_mount"
         type="fixed">

    <parent link="wrist_link_pitch"/>
    <child link="wrist_actuator_roll"/>

    <origin
        xyz="0 0.080000 -0.033519"
        rpy="${pi/2} 0 ${-pi/2}"/>

  </joint>


  <!-- ========================================================= -->
  <!-- Q5 : WRIST ROLL -->
  <!-- ========================================================= -->

  <link name="wrist_link_roll">

    <xacro:mesh_visual
        mesh="wrist_link_roll"
        material="petg_charcoal"/>

  </link>


  <joint name="wrist_roll_joint"
         type="revolute">

    <parent link="wrist_link_pitch"/>
    <child link="wrist_link_roll"/>

    <origin
        xyz="0 0.080000 -0.033519"
        rpy="${pi/2} 0 ${-pi/2}"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-0.75"
        upper="0.63"
        effort="1.0"
        velocity="5.035176563244"/>

  </joint>


  <!-- ========================================================= -->
  <!-- WRIST YAW ACTUATOR -->
  <!-- world displacement -->
  <!-- wrist roll -> wrist yaw -->
  <!-- (0,0,+75) mm -->
  <!-- expressed in WRIST-ROLL frame -->
  <!-- (-75,0,0) mm -->
  <!-- ========================================================= -->

  <link name="wrist_actuator_yaw">

    <xacro:mesh_visual
        mesh="wrist_actuator_yaw"
        material="motor_grey"/>

  </link>


  <joint name="wrist_yaw_actuator_mount"
         type="fixed">

    <parent link="wrist_link_roll"/>
    <child link="wrist_actuator_yaw"/>

    <origin
        xyz="-0.075000 0 0"
        rpy="${pi/2} 0 ${-pi/2}"/>

  </joint>


  <!-- ========================================================= -->
  <!-- Q6 : WRIST YAW -->
  <!-- ========================================================= -->

  <link name="wrist_link_yaw">

    <xacro:mesh_visual
        mesh="wrist_link_yaw"
        material="petg_charcoal"/>

  </link>


  <joint name="wrist_yaw_joint"
         type="revolute">

    <parent link="wrist_link_roll"/>
    <child link="wrist_link_yaw"/>

    <origin
        xyz="-0.075000 0 0"
        rpy="${pi/2} 0 ${-pi/2}"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-5.76"
        upper="6.5"
        effort="1.0"
        velocity="1.0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- EE ACTUATOR DRIVE GEAR -->
  <!-- wrist yaw -> EE drive gear centre:
       wrist-yaw local (0, -34, +78.36) mm
       measured world (-34, 0, +78.36) mm -->
  <!-- wrist_yaw frame -->
  <!-- Xe = +Yworld -->
  <!-- Ye = -Xworld -->
  <!-- Ze = +Zworld -->
  <!-- 따라서 local displacement = (0,0,+62 mm) -->
  <!-- ========================================================= -->

  <link name="ee_actuator">

    <xacro:mesh_visual
        mesh="ee_gear"
        material="motor_grey"/>

  </link>


  <joint name="ee_actuator_mount"
         type="fixed">

    <parent link="wrist_link_yaw"/>
    <child link="ee_actuator"/>

    <origin
        xyz="0 0.034000 0.078360"
        rpy="0 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- TCP -->
  <!-- Driven tool spur-gear centre is the common TCP.  It is a sibling of
       ee_actuator because the drive-gear centre is offset by 34 mm. -->
  <!-- ========================================================= -->

  <link name="tcp_link"/>


  <joint name="tcp_joint"
         type="fixed">

    <parent link="wrist_link_yaw"/>
    <child link="tcp_link"/>

    <origin
        xyz="0 0 0.078360"
        rpy="0 0 0"/>

  </joint>


  <!-- Common end-effector output: Dynamixel ID 4 is always ee_joint.
       Tool 1 fixes its housing and racks to tcp_link and mounts only the driven
       spur gear on ee_output_link. Other tools use the rotating output. -->
  <link name="ee_output_link"/>
  <joint name="ee_joint" type="continuous">
    <parent link="tcp_link"/><child link="ee_output_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit effort="8.4" velocity="5.035177"/>
  </joint>

  <!-- Physical D435 mounting/bolt centre in the wrist-yaw frame:
       (X=0, Y=+94.768, Z=+59.46) mm.  Since tcp_link is at wrist-yaw
       Z=+78.36 mm with the same orientation, the TCP-relative Z is -18.9 mm.
       cam_link axes are X forward, Y left, Z up. -->

  <link name="cam_link">

    <xacro:mesh_visual
        mesh="cam_d435"
        material="motor_grey"/>

  </link>


  <joint name="cam_link_mount"
         type="fixed">

    <parent link="tcp_link"/>
    <child link="cam_link"/>

    <origin
        xyz="0 0.094768 -0.018900"
        rpy="${-pi/2} ${-pi/2} 0"/>
  </joint>

  <!-- realsense2_camera prefixes camera_name=arm_camera to base_frame_id,
       producing arm_camera_cam_link.  The driver uses that root as the depth
       sensor origin, so it is offset from the physical mounting centre. -->
  <link name="arm_camera_cam_link"/>
  <joint name="cam_link_to_realsense_base" type="fixed">
    <parent link="cam_link"/>
    <child link="arm_camera_cam_link"/>
    <origin xyz="$(arg camera_depth_from_mount_x) $(arg camera_depth_from_mount_y) $(arg camera_depth_from_mount_z)"
            rpy="0 0 0"/>
  </joint>

  <!-- The common arm ends at tcp_link; the selected tool is downstream. -->
  <xacro:if value="${selected_tool_id == 0}">
    <xacro:tool_1_gripper prefix="" parent="tcp_link" drive_parent="ee_output_link" use_mesh="$(arg use_mesh)"/>
  </xacro:if>
  <xacro:if value="${selected_tool_id == 1}">
    <xacro:tool_2 prefix="" parent="ee_output_link" use_mesh="$(arg use_mesh)"/>
  </xacro:if>
  <xacro:if value="${selected_tool_id == 2}">
    <xacro:tool_3 prefix="" parent="ee_output_link" use_mesh="$(arg use_mesh)"/>
  </xacro:if>

</robot>
