<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="tool_2" params="prefix parent use_mesh:=false">
    <joint name="${prefix}tool_2_mount_joint" type="fixed"><parent link="${parent}"/><child link="${prefix}tool_2_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
    <link name="${prefix}tool_2_link">
      <xacro:if value="${use_mesh}">
        <visual><geometry><mesh filename="package://tool_manipulator_description/meshes/visual/tool1_drill.stl" scale="0.001 0.001 0.001"/></geometry><material name="motor_grey"/></visual>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <!-- Keep the drill visible in RobotModel while using the lighter
             collision STL. The fixed parent below makes it rotate 1:1 with
             ee_output_link/ee_joint. -->
        <visual><geometry><mesh filename="package://tool_manipulator_description/meshes/collision/tool1_drill.stl" scale="0.001 0.001 0.001"/></geometry><material name="motor_grey"/></visual>
      </xacro:unless>
      <collision><geometry><mesh filename="package://tool_manipulator_description/meshes/collision/tool1_drill.stl" scale="0.001 0.001 0.001"/></geometry></collision>
      <inertial><origin xyz="0 0 0.030"/><mass value="0.050"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.000004"/></inertial>
    </link>
    <joint name="${prefix}tool_2_tcp_joint" type="fixed"><parent link="${prefix}tool_2_link"/><child link="${prefix}tool_2_tcp"/><origin xyz="0 0 0.060"/></joint>
    <link name="${prefix}tool_2_tcp"/>
  </xacro:macro>
</robot>
