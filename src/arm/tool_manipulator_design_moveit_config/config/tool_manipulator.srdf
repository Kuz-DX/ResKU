<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="tool_manipulator">
    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <!--LINKS: When a link is specified, the parent joint of that link (if it exists) is automatically included-->
    <!--JOINTS: When a joint is specified, the child link of that joint (which will always exist) is automatically included-->
    <!--CHAINS: When a chain is specified, all the links along the chain (including endpoints) are included in the group. Additionally, all the joints that are parents to included links are also included. This means that joints along the chain and the parent joint of the base link are included in the group-->
    <!--SUBGROUPS: Groups can also be formed by referencing to already defined group names-->
    <group name="arm">
        <chain base_link="base_actuator" tip_link="tcp_link"/>
    </group>
    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
    <group_state name="home" group="arm">
        <joint name="base_joint" value="0"/>
        <joint name="elbow_joint" value="1.5584"/>
        <joint name="shoulder_joint" value="-1.4659"/>
        <joint name="wrist_pitch_joint" value="-1.3186"/>
        <joint name="wrist_roll_joint" value="0"/>
        <joint name="wrist_yaw_joint" value="0"/>
    </group_state>
    <!--
      AprilTag 도킹의 첫 안전 대기 자세. 이 상태에서는 팔을 중립/신장 자세로
      두고, wrist-mounted camera가 도킹 스테이션을 재탐색할 수 있다.

      dock_pre는 체결점이나 tag를 향한 목표 자세가 아니다. 실제 rack 위치와
      tag 시야를 기준으로 현장에서 저속 검증한 뒤에만 값을 변경한다. 이 pose
      다음에 tag 기반 pre_insert pose를 계산하고 MoveIt으로 접근한다.
    -->
    <group_state name="dock_pre" group="arm">
        <joint name="base_joint" value="0.0"/>
        <joint name="shoulder_joint" value="0.0"/>
        <joint name="elbow_joint" value="0.0"/>
        <joint name="wrist_pitch_joint" value="0.0"/>
        <joint name="wrist_roll_joint" value="0"/>
        <joint name="wrist_yaw_joint" value="0.0"/>
    </group_state>
    <!-- Common rack-facing posture used before each tag-specific approach. -->
    <group_state name="docking_wait" group="arm">
        <joint name="base_joint" value="3.14159265"/>
        <joint name="shoulder_joint" value="0.0"/>
        <joint name="elbow_joint" value="0.0"/>
        <joint name="wrist_pitch_joint" value="0.0"/>
        <joint name="wrist_roll_joint" value="0"/>
        <joint name="wrist_yaw_joint" value="0.0"/>
    </group_state>
    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <!-- Intentional contact between each actuator housing and its adjacent
         mounting/output links.  Keep all non-adjacent self-collision checks. -->
    <disable_collisions link1="base_actuator" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="shoulder_actuator" reason="Adjacent"/>
    <disable_collisions link1="shoulder_actuator" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="elbow_actuator" reason="Adjacent"/>
    <disable_collisions link1="elbow_actuator" link2="elbow_link" reason="Adjacent"/>
    <disable_collisions link1="elbow_link" link2="wrist_actuator_pitch" reason="Adjacent"/>
    <disable_collisions link1="wrist_actuator_pitch" link2="wrist_link_pitch" reason="Adjacent"/>
    <disable_collisions link1="wrist_link_pitch" link2="wrist_actuator_roll" reason="Adjacent"/>
    <disable_collisions link1="wrist_actuator_roll" link2="wrist_link_roll" reason="Adjacent"/>
    <disable_collisions link1="wrist_link_roll" link2="wrist_actuator_yaw" reason="Adjacent"/>
    <disable_collisions link1="wrist_actuator_yaw" link2="wrist_link_yaw" reason="Adjacent"/>
    <disable_collisions link1="wrist_link_yaw" link2="ee_actuator" reason="Adjacent"/>

</robot>
